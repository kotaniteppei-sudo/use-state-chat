{
  "name": "training-materials-checkpoint-21",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --max-warnings=0",
    "test:app": "vitest run --config vitest.config.ts",
    "test:firebase-unit": "vitest run --config vitest.firebase-unit.config.ts",
    "test:unit": "npm run test:app && npm run test:firebase-unit",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:emulators": "firebase emulators:exec --project demo-training-chat --only auth,firestore,storage \"npm run test:rules && npm run test:integration\"",
    "build": "next build",
    "verify:docker": "node scripts/verify-docker.mjs",
    "emulators": "firebase emulators:start --project demo-training-chat --only auth,firestore,storage",
    "validate:cloudbuild": "node scripts/validate-cloudbuild.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "firebase": "12.17.1",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "14.2.0",
    "firebase-tools": "15.25.1",
    "jsdom": "^30.1.0",
    "react-test-renderer": "19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
