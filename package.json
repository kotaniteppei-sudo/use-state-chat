{
  "name": "training-checkpoint-16",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-env.mjs",
    "build": "next build",
    "prestart": "node scripts/check-env.mjs",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "check:secret": "node scripts/check-client-secret.mjs",
    "test:emulators": "firebase emulators:exec --project demo-training-chat --only firestore \"npm run test:rules\"",
    "test:rules": "vitest run --config vitest.rules.config.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.2.0",
    "@mui/material-nextjs": "9.1.1",
    "@next/env": "16.3.0",
    "firebase": "12.17.1",
    "firebase-tools": "15.25.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.17.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "react-test-renderer": "^19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
